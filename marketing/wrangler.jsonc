{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "floorbeat-site",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // The Worker runs before every asset so signed-in users are redirected
    // to their dashboard instead of being served a marketing page.
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  // www also has an exact route: a route wins over a custom domain, and the customer Worker's
  // *.floorbeat.in route (factories' own addresses) must never take it. The bare domain is not
  // under *.floorbeat.in. worker-routes.test.ts (the app's tests) holds the rule.
  "routes": [
    { "pattern": "floorbeat.in", "custom_domain": true },
    { "pattern": "www.floorbeat.in", "custom_domain": true },
    { "pattern": "www.floorbeat.in/*", "zone_name": "floorbeat.in" }
  ],
  "vars": {
    "APP_ORIGIN": "https://app.floorbeat.in",
    "STAFF_ORIGIN": "https://ops.floorbeat.in",
    "API_ORIGIN": "https://api.floorbeat.in",
    // Each factory signs in at its own address, <id>.floorbeat.in (src/redirect.ts factoryOrigin).
    "FACTORY_HOST_SUFFIX": ".floorbeat.in"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "stage": {
      "name": "floorbeat-site-stage",
      "routes": [
        { "pattern": "stage-www.floorbeat.in", "custom_domain": true },
        { "pattern": "stage-www.floorbeat.in/*", "zone_name": "floorbeat.in" }
      ],
      "vars": {
        "APP_ORIGIN": "https://stage-app.floorbeat.in",
        "STAFF_ORIGIN": "https://stage-ops.floorbeat.in",
        "API_ORIGIN": "https://api-stage.floorbeat.in",
        "FACTORY_HOST_SUFFIX": ".stage.floorbeat.in",
        "NON_PRODUCTION": "true"
      }
    },
    "dev": {
      "name": "floorbeat-site-dev",
      "routes": [
        { "pattern": "dev-www.floorbeat.in", "custom_domain": true },
        { "pattern": "dev-www.floorbeat.in/*", "zone_name": "floorbeat.in" }
      ],
      "vars": {
        "APP_ORIGIN": "https://dev-app.floorbeat.in",
        "STAFF_ORIGIN": "https://dev-ops.floorbeat.in",
        "API_ORIGIN": "https://api-dev.floorbeat.in",
        "FACTORY_HOST_SUFFIX": ".dev.floorbeat.in",
        "NON_PRODUCTION": "true"
      }
    }
  }
}
