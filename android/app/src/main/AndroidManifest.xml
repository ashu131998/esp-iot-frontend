<?xml version="1.0" encoding="utf-8"?>
<!--
    FloorBeat for Android (README.md): one app since 3.0.0, its alerts, its dashboard and its stock behind a home
    screen of apps. Its screens are dashboard.floorbeat.in, shown in the phone's own web view; notifications
    (Firebase), the camera for the stock's photos, the back button, links, the first-start set-up, the phone's
    settings and the offline screen are the app's own. It is FloorBeat Alerts' package, so it installs over it
    as an update and its notifications go on ringing through the update.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The stock's photo fields take pictures (the camera app; a page may also ask for the camera itself). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- A phone without a camera can still pick photos from the phone. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- Android 11+: the camera app and the photo picker a photo field is handed to. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
            <data android:mimeType="image/*" />
        </intent>
    </queries>

    <application
        android:name=".FloorBeatApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.FloorBeat.Starting">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <!-- A link to dashboard.floorbeat.in opens in the app. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="dashboard.floorbeat.in" />
            </intent-filter>
            <!-- A link to the alerts' old address (an alert's address in a message already sent) opens its page in the app. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="alerts.floorbeat.in" />
            </intent-filter>
        </activity>

        <!--
            The launcher entry keeps the name it had in 1.0.0 (the Trusted Web Activity's LauncherActivity),
            so an icon a worker put on the home screen survives the update.
        -->
        <activity-alias
            android:name="in.floorbeat.alerts.LauncherActivity"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".MessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Where the camera app writes a photo taken for a stock field (the app's own cache, handed to the page). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.photos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/photo_paths" />
        </provider>

        <!-- FCM registers the phone by its Firebase Installation ID (the server sends to the FID). -->
        <meta-data
            android:name="firebase_messaging_installation_id_enabled"
            android:value="true" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/channel_alerts_id" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
    </application>
</manifest>
