{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "floorbeat-site",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // The Worker runs before every asset so signed-in users are redirected
    // to their dashboard instead of being served a marketing page.
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "floorbeat.in", "custom_domain": true },
    { "pattern": "www.floorbeat.in", "custom_domain": true }
  ],
  "vars": {
    "APP_ORIGIN": "https://app.floorbeat.in",
    "STAFF_ORIGIN": "https://ops.floorbeat.in",
    "API_ORIGIN": "https://api.floorbeat.in"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "stage": {
      "name": "floorbeat-site-stage",
      "routes": [{ "pattern": "stage-www.floorbeat.in", "custom_domain": true }],
      "vars": {
        "APP_ORIGIN": "https://stage-app.floorbeat.in",
        "STAFF_ORIGIN": "https://stage-ops.floorbeat.in",
        "API_ORIGIN": "https://api-stage.floorbeat.in",
        "NON_PRODUCTION": "true"
      }
    },
    "dev": {
      "name": "floorbeat-site-dev",
      "routes": [{ "pattern": "dev-www.floorbeat.in", "custom_domain": true }],
      "vars": {
        "APP_ORIGIN": "https://dev-app.floorbeat.in",
        "STAFF_ORIGIN": "https://dev-ops.floorbeat.in",
        "API_ORIGIN": "https://api-dev.floorbeat.in",
        "NON_PRODUCTION": "true"
      }
    }
  }
}
