{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Default environment = staff console (ops host). `--env app` deploys the
  // same build as the customer dashboard, where /internal is not served.
  "name": "esp-iot-frontend",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  // Run near the API in Germany rather than near the visitor: every page is several API calls,
  // so one longer hop beats four. (Lighthouse 2026-11-01: TTFB 0.5–1 s on phones.)
  "placement": { "mode": "smart" },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Every address also has an exact route: a route wins over a custom domain, and the customer
  // Worker's *.floorbeat.in route (factories' own addresses) must never take these.
  // worker-routes.test.ts holds the rule.
  "routes": [
    { "pattern": "ops.floorbeat.in", "custom_domain": true },
    { "pattern": "admin.floorbeat.in", "custom_domain": true },
    { "pattern": "superadmin.floorbeat.in", "custom_domain": true },
    { "pattern": "ops.floorbeat.in/*", "zone_name": "floorbeat.in" },
    { "pattern": "admin.floorbeat.in/*", "zone_name": "floorbeat.in" },
    { "pattern": "superadmin.floorbeat.in/*", "zone_name": "floorbeat.in" }
  ],
  "workers_dev": true,
  "vars": {
    "INTERNAL_STAFF_HOSTNAMES": "ops.floorbeat.in,admin.floorbeat.in,superadmin.floorbeat.in,esp-iot-frontend.ashu131998.workers.dev",
    // superadmin.floorbeat.in is the super admin's, admin.floorbeat.in the staff's; ops takes both.
    "STAFF_HOST_ROLES": "superadmin.floorbeat.in=super_admin;admin.floorbeat.in=internal_admin,internal_viewer",
    "SESSION_HINT_COOKIE_DOMAIN": "floorbeat.in"
  },
  "env": {
    "app": {
      "name": "esp-iot-frontend-app",
      "routes": [
        { "pattern": "app.floorbeat.in", "custom_domain": true },
        { "pattern": "app.floorbeat.in/*", "zone_name": "floorbeat.in" },
        // Every factory's own address, <id>.floorbeat.in (with the proxied DNS record "*"). Every
        // other address has an exact route of its own, which wins (worker-routes.test.ts).
        { "pattern": "*.floorbeat.in/*", "zone_name": "floorbeat.in" }
      ],
      "workers_dev": true,
      "vars": {
        "INTERNAL_STAFF_HOSTNAMES": "ops.floorbeat.in,admin.floorbeat.in,superadmin.floorbeat.in,esp-iot-frontend.ashu131998.workers.dev",
        // <factory>.floorbeat.in serves that factory alone (src/lib/hosts.ts); live once *.floorbeat.in reaches this Worker.
        "FACTORY_HOST_SUFFIX": ".floorbeat.in",
        "SESSION_HINT_COOKIE_DOMAIN": "floorbeat.in",
        "MARKETING_URL": "https://floorbeat.in",
        "STAFF_URL": "https://ops.floorbeat.in/internal"
      }
    },
    // Stage and dev mirror production: <env>-ops (staff console) and <env>-app
    // (customer dashboard), against their own API. No shared hint cookie: it
    // would live on floorbeat.in next to production's. JWT_ACCESS_SECRET is set by CI.
    "stage": {
      "name": "esp-iot-frontend-stage",
      "routes": [
        { "pattern": "stage-ops.floorbeat.in", "custom_domain": true },
        { "pattern": "stage-ops.floorbeat.in/*", "zone_name": "floorbeat.in" }
      ],
      "workers_dev": true,
      "vars": {
        "INTERNAL_STAFF_HOSTNAMES": "stage-ops.floorbeat.in,esp-iot-frontend-stage.ashu131998.workers.dev",
        "API_INTERNAL_URL": "https://api-stage.floorbeat.in"
      }
    },
    "stage-app": {
      "name": "esp-iot-frontend-stage-app",
      "routes": [
        { "pattern": "stage-app.floorbeat.in", "custom_domain": true },
        { "pattern": "stage-app.floorbeat.in/*", "zone_name": "floorbeat.in" }
      ],
      "workers_dev": true,
      "vars": {
        "INTERNAL_STAFF_HOSTNAMES": "stage-ops.floorbeat.in,esp-iot-frontend-stage.ashu131998.workers.dev",
        "API_INTERNAL_URL": "https://api-stage.floorbeat.in",
        "MARKETING_URL": "https://stage-www.floorbeat.in",
        "STAFF_URL": "https://stage-ops.floorbeat.in/internal"
      }
    },
    "dev": {
      "name": "esp-iot-frontend-dev",
      "routes": [
        { "pattern": "dev-ops.floorbeat.in", "custom_domain": true },
        { "pattern": "dev-ops.floorbeat.in/*", "zone_name": "floorbeat.in" }
      ],
      "workers_dev": true,
      "vars": {
        "INTERNAL_STAFF_HOSTNAMES": "dev-ops.floorbeat.in,esp-iot-frontend-dev.ashu131998.workers.dev",
        "API_INTERNAL_URL": "https://api-dev.floorbeat.in"
      }
    },
    "dev-app": {
      "name": "esp-iot-frontend-dev-app",
      "routes": [
        { "pattern": "dev-app.floorbeat.in", "custom_domain": true },
        { "pattern": "dev-app.floorbeat.in/*", "zone_name": "floorbeat.in" }
      ],
      "workers_dev": true,
      "vars": {
        "INTERNAL_STAFF_HOSTNAMES": "dev-ops.floorbeat.in,esp-iot-frontend-dev.ashu131998.workers.dev",
        "API_INTERNAL_URL": "https://api-dev.floorbeat.in",
        "MARKETING_URL": "https://dev-www.floorbeat.in",
        "STAFF_URL": "https://dev-ops.floorbeat.in/internal"
      }
    }
  }
}
