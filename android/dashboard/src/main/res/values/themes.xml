<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The app: white, edge to edge (MainActivity pads the page clear of the system bars). -->
    <style name="Theme.FloorBeat" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- The start: the app's icon on white until the first page has loaded. -->
    <style name="Theme.FloorBeat.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="postSplashScreenTheme">@style/Theme.FloorBeat</item>
    </style>
</resources>
